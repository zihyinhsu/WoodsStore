# ============================================================
# 備份設定（複製本檔為 backup.env 後填入實際值）
#
# ⚠️ backup.env 含資料庫密碼與 S3 金鑰，不進版控（已加入 .gitignore）。
#    放在 NAS 上時請確認權限：chmod 600 scripts/backup.env
# ============================================================

# ------------------------------------------------------------
# 1. 正式資料庫連線字串（必填）
#
# 取得方式：Supabase Dashboard → 選正式專案 → 上方 Connect 按鈕
#           → 選「Session pooler」那一條，整串複製
#
# 為什麼一定要 Session pooler（port 5432）而不是 Transaction pooler（6543）：
#   官方明載 Transaction mode 不支援 prepared statements，pg_dump 會失敗。
#
# 為什麼不用 Direct connection（db.xxx.supabase.co）：
#   那條在多數專案是 IPv6-only。家用網路多半沒有 IPv6，會連不上。
#   Session pooler 是 IPv4，從 NAS 連得到。
#
# 複製回來的字串裡有 [YOUR-PASSWORD] 佔位符，要換成真正的資料庫密碼
# （不是你登入 Supabase 的密碼，是 Settings → Database 的密碼，
#   忘記可在該頁重設）。
#
# ⚠️ 密碼含特殊字元時必須做 URL 編碼，否則連線字串會被解析錯誤：
#      @ → %40      / → %2F      # → %23      ? → %3F
#      : → %3A      & → %26      空白 → %20
#    例如密碼 p@ss/w0rd 要寫成 p%40ss%2Fw0rd
#    最省事的做法是重設一個只含英數字的密碼。
# ------------------------------------------------------------
PROD_DB_URL='postgresql://postgres.XXXXXXXX:YOUR-PASSWORD@aws-X-XX-XXXX-X.pooler.supabase.com:5432/postgres'

# ------------------------------------------------------------
# 2. 備份存放處：S3（必填）
#
# 備份上傳到 NAS 上的 rustfs，保留 7 天（見第 5 節）。
#
# S3_ENDPOINT 用 127.0.0.1:9000 直連同一台 NAS 的 rustfs，
# 不要填 https://files.nildev.net：那條會出網路經 Cloudflare 再繞回來，
# 且 Cloudflare 免費方案單次上傳上限 100MB。
#
# 金鑰在 rustfs 管理介面（port 9001）建立，需要對這個 bucket
# 讀、寫、列出、刪除的權限（刪除用於清掉超過 7 天的備份）。
# 範圍只開這個 bucket 就好，金鑰外洩時影響不到 NAS 上其他資料。
# ------------------------------------------------------------
S3_ENDPOINT='http://127.0.0.1:9000'
S3_BUCKET='yijing'
S3_PREFIX='inventory'
S3_ACCESS_KEY='YOUR-ACCESS-KEY'
S3_SECRET_KEY='YOUR-SECRET-KEY'

# 本機暫存目錄（選填，預設為 scripts/work）。
# 備份先在這裡驗證、上傳 S3 確認後即刪除；backup.log 也寫在這裡。
# STAGING_DIR='/volume1/scripts/yijing-backup/scripts/work'

# ------------------------------------------------------------
# 3. dev 資料庫連線字串（選填）
#
# 填了才會一併備份 dev 庫（與正式庫同時段、同樣保留 7 天）；
# 留空則只備份正式庫。取得方式同上，但選的是 dev 專案。
# ------------------------------------------------------------
# DEV_DB_URL='postgresql://postgres.YYYYYYYY:YOUR-PASSWORD@aws-X-XX-XXXX-X.pooler.supabase.com:5432/postgres'

# ------------------------------------------------------------
# 4. 用正式庫刷新 dev（本專案開啟）
#
# yes：每次備份後把 dev 清空、灌入剛備份的正式資料。
# 排程一天跑兩次，dev 每天中午、傍晚各被覆寫一次，
# 白天在 dev 上做的東西都會消失——dev 定位是正式庫的複本，不在上面存東西。
# 覆寫前會先備份 dev，萬一灌錯可用 fetch-backup.sh 抓 dev-*.sql.gz 還原回來。
# 不想刷新時改成 no 或整行刪掉（腳本在沒設定時不刷新）。
#
# ⚠️ 開啟時 DEV_DB_URL 絕對不可填成正式專案的連線字串。
#    腳本有三道防護會攔（同主機、同 project ref、單據數超標），
#    但不要依賴防護——填錯的代價是正式資料被稍早的備份覆蓋。
# ------------------------------------------------------------
REFRESH_DEV_FROM_PROD=yes

# dev 刷新的單據數安全門檻（選填，預設 5000，只在上面開啟時有作用）
#
# 還原前會檢查目標庫的單據數，超過門檻就中止，避免輾過有實際資料的庫。
# 正式資料成長到接近這個數字後，dev 刷新會開始被攔下來——
# 那時把這個數字調大即可（代表你確認過目標真的是 dev）。
# ------------------------------------------------------------
# ALLOW_DEV_ORDERS=5000

# ------------------------------------------------------------
# 5. 保留期限（選填）
#
# 每次備份成功後，刪除 S3 上該庫超過 S3_RETENTION_DAYS 天的備份。
# 但不論多舊，最新的 S3_KEEP_MIN 份一律保留：排程停擺一段時間後恢復時，
# 不會因為「全都超過 7 天」而一口氣刪到只剩一份。
# 預設 14 = 一天兩份 × 7 天。
# ------------------------------------------------------------
# S3_RETENTION_DAYS=7
# S3_KEEP_MIN=14
