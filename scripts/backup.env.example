# ============================================================
# 備份設定（複製本檔為 backup.env 後填入實際值）
#
# ⚠️ backup.env 含資料庫密碼，不進版控（已加入 .gitignore）。
#    放在 NAS 上時請確認權限：chmod 600 scripts/backup.env
# ============================================================

# ------------------------------------------------------------
# 1. 正式資料庫連線字串（必填）
#
# 取得方式：Supabase Dashboard → 選正式專案 → 上方 Connect 按鈕
#           → 選「Session pooler」那一條，整串複製
#
# 為什麼一定要 Session pooler（port 5432）而不是 Transaction pooler（6543）：
#   官方明載 Transaction mode 不支援 prepared statements，pg_dump 會失敗。
#
# 為什麼不用 Direct connection（db.xxx.supabase.co）：
#   那條在多數專案是 IPv6-only。家用網路多半沒有 IPv6，會連不上。
#   Session pooler 是 IPv4，從 NAS 連得到。
#
# 複製回來的字串裡有 [YOUR-PASSWORD] 佔位符，要換成真正的資料庫密碼
# （不是你登入 Supabase 的密碼，是 Settings → Database 的密碼，
#   忘記可在該頁重設）。
#
# ⚠️ 密碼含特殊字元時必須做 URL 編碼，否則連線字串會被解析錯誤：
#      @ → %40      / → %2F      # → %23      ? → %3F
#      : → %3A      & → %26      空白 → %20
#    例如密碼 p@ss/w0rd 要寫成 p%40ss%2Fw0rd
#    最省事的做法是重設一個只含英數字的密碼。
# ------------------------------------------------------------
PROD_DB_URL='postgresql://postgres.XXXXXXXX:YOUR-PASSWORD@aws-X-XX-XXXX-X.pooler.supabase.com:5432/postgres'

# ------------------------------------------------------------
# 2. 備份存放目錄（必填）
#
# NAS 上的實際路徑。先在 File Station 建好共用資料夾，
# 路徑通常長這樣（volume1 依你的儲存空間而定）：
# ------------------------------------------------------------
BACKUP_DIR='/volume1/backup/inventory'

# ------------------------------------------------------------
# 3. dev 資料庫連線字串（選填）
#
# 填了才會每天把正式資料刷新到 dev 庫；留空則只做 NAS 備份。
# 取得方式同上，但選的是 dev 專案。
#
# ⚠️ 這個庫每天會被「清空後重灌」。絕對不要填正式專案的連線字串。
#    腳本有三道防護會攔（同主機、同 project ref、單據數超標），
#    但不要依賴防護——填錯的代價是正式資料被昨天的備份覆蓋。
# ------------------------------------------------------------
# DEV_DB_URL='postgresql://postgres.YYYYYYYY:YOUR-PASSWORD@aws-X-XX-XXXX-X.pooler.supabase.com:5432/postgres'

# ------------------------------------------------------------
# 4. dev 庫單據數安全門檻（選填，預設 5000）
#
# 還原前會檢查目標庫的單據數，超過門檻就中止，避免輾過有實際資料的庫。
# 正式資料成長到接近這個數字後，dev 刷新會開始被攔下來——
# 那時把這個數字調大即可（代表你確認過目標真的是 dev）。
# ------------------------------------------------------------
# ALLOW_DEV_ORDERS=5000
